# Copy to .env and adjust as needed for local development.
# These are non-secret local-development defaults only.

APP_NAME=App Review Intelligence API
APP_ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# psycopg 3 SQLAlchemy driver, local Docker Compose database.
APP_DATABASE_URL=postgresql+psycopg://app_review:app_review@localhost:5432/app_review_intelligence
APP_DATABASE_ECHO=false
