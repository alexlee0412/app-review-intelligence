# Copy to .env and adjust as needed for local development.
# These are non-secret local-development defaults only.

APP_NAME=App Review Intelligence API
APP_ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
# APP_CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# psycopg 3 SQLAlchemy driver, local Docker Compose database.
APP_DATABASE_URL=postgresql+psycopg://app_review:app_review@localhost:5432/app_review_intelligence
APP_DATABASE_ECHO=false

# Put real tokens only in .env (gitignored) or Vercel project environment variables.
APP_APIFY_API_TOKEN=replace-with-apify-token
APP_APIFY_DATASET_ID=replace-with-dataset-id
APP_EMBEDDING_PROVIDER=fake
APP_EMBEDDING_MODEL=text-embedding-3-small
APP_EMBEDDING_DIMENSION=1536
APP_EMBEDDING_BATCH_SIZE=128
APP_OPENAI_API_KEY=replace-with-openai-api-key

# Question interpretation and answer synthesis. Reuses APP_OPENAI_API_KEY.
# 'fake' is a deterministic stub for tests and offline work; it produces no real
# analysis and is rejected outside development and test.
APP_LLM_PROVIDER=fake
APP_PLANNER_MODEL=gpt-5-mini
APP_SYNTHESIZER_MODEL=gpt-5
# Optional synthesizer-only value: low, medium, or high. Omit for provider default.
# APP_SYNTHESIZER_REASONING_EFFORT=low
APP_LLM_TIMEOUT_SECONDS=180
APP_LLM_MAX_OUTPUT_TOKENS=8000
